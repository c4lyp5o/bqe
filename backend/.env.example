NODE_ENV=production
PORT=5000
# socket.io listens on its own port — publish it too
WS_PORT=5001
HOST=0.0.0.0
DB_PATH=/data/bqe.db
# Built frontend directory (served by the backend when present)
# CLIENT_DIR=../frontend/dist
# Allowed CORS / socket.io origin. Set to your public URL in production.
CLIENT_ORIGIN=https://bqe.example.com
